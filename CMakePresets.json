{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-debug",
      "displayName": "CPU reference (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MICROSIMULATOR_BUILD_PYTHON": "OFF",
        "MICROSIMULATOR_BUILD_TESTS": "ON",
        "MICROSIMULATOR_ENABLE_CUDA": "OFF",
        "MICROSIMULATOR_ENABLE_METAL": "OFF"
      }
    },
    {
      "name": "metal-debug",
      "displayName": "Native Metal (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/metal-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MICROSIMULATOR_BUILD_PYTHON": "OFF",
        "MICROSIMULATOR_BUILD_TESTS": "ON",
        "MICROSIMULATOR_ENABLE_CUDA": "OFF",
        "MICROSIMULATOR_ENABLE_METAL": "ON"
      }
    },
    {
      "name": "cuda-debug",
      "displayName": "Native CUDA (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cuda-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MICROSIMULATOR_BUILD_PYTHON": "OFF",
        "MICROSIMULATOR_BUILD_TESTS": "ON",
        "MICROSIMULATOR_ENABLE_CUDA": "ON",
        "MICROSIMULATOR_ENABLE_METAL": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug"
    },
    {
      "name": "metal-debug",
      "configurePreset": "metal-debug"
    },
    {
      "name": "cuda-debug",
      "configurePreset": "cuda-debug"
    }
  ],
  "testPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "metal-debug",
      "configurePreset": "metal-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-debug",
      "configurePreset": "cuda-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
