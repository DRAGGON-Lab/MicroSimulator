// Opcodes of the typed rate-expression instruction set: MICROSIMULATOR_RATE_OP(name, code).
//
// This list is the one definition of the numbering. microsimulator/species.hpp expands it
// into the RateOp enumeration, which the CPU and CUDA interpreters switch on,
// and the Metal build expands it into the rate_op_* constants its shaders
// switch on. A code is part of the checkpoint format and never changes.
MICROSIMULATOR_RATE_OP(constant, 0)
MICROSIMULATOR_RATE_OP(species, 1)
MICROSIMULATOR_RATE_OP(position_x, 2)
MICROSIMULATOR_RATE_OP(position_y, 3)
MICROSIMULATOR_RATE_OP(position_z, 4)
MICROSIMULATOR_RATE_OP(cell_length, 5)
MICROSIMULATOR_RATE_OP(cell_radius, 6)
MICROSIMULATOR_RATE_OP(growth_rate, 7)
MICROSIMULATOR_RATE_OP(cell_type, 8)
MICROSIMULATOR_RATE_OP(cell_volume, 9)
MICROSIMULATOR_RATE_OP(cell_surface_area, 10)
MICROSIMULATOR_RATE_OP(add, 11)
MICROSIMULATOR_RATE_OP(subtract, 12)
MICROSIMULATOR_RATE_OP(multiply, 13)
MICROSIMULATOR_RATE_OP(divide, 14)
MICROSIMULATOR_RATE_OP(power, 15)
MICROSIMULATOR_RATE_OP(minimum, 16)
MICROSIMULATOR_RATE_OP(maximum, 17)
MICROSIMULATOR_RATE_OP(negate, 18)
MICROSIMULATOR_RATE_OP(exponential, 19)
MICROSIMULATOR_RATE_OP(logarithm, 20)
MICROSIMULATOR_RATE_OP(less, 21)
MICROSIMULATOR_RATE_OP(less_equal, 22)
MICROSIMULATOR_RATE_OP(greater, 23)
MICROSIMULATOR_RATE_OP(greater_equal, 24)
MICROSIMULATOR_RATE_OP(equal, 25)
MICROSIMULATOR_RATE_OP(select, 26)
MICROSIMULATOR_RATE_OP(signal, 27)
MICROSIMULATOR_RATE_OP(cell_volume_change_rate, 28)
